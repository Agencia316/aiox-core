    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "next": "^14.2.15",
    "openai": "^4.68.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
