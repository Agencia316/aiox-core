    "test:watch": "jest --rootDir tests --watch",
    "lint": "eslint src bin tests --ext .js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
