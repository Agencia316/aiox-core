{
  "name": "@aiox/whatsapp-crm",
  "version": "0.2.0",
  "private": true,
  "description": "WhatsApp CRM Kanban with AI agents (OpenAI/Gemini) — CLI + Next.js Dashboard",
  "main": "src/cli/index.js",
  "bin": {
    "whatsapp-crm": "bin/whatsapp-crm.js"
  },
  "scripts": {
    "start": "node bin/whatsapp-crm.js",
    "qr": "node bin/whatsapp-crm.js qr",
    "migrate": "node src/db/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "dev": "next dev -p 3100",
