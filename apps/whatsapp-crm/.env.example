# WhatsApp CRM Environment Variables
# Copy to .env and fill in your keys. Never commit .env.

# =============================================================================
# AI Providers (at least one is required to use agents)
# =============================================================================

# OpenAI (ChatGPT)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# =============================================================================
# Database
# =============================================================================

# SQLite file path (default: ./data/whatsapp-crm.db)
DB_PATH=./data/whatsapp-crm.db

# =============================================================================
# WhatsApp Worker
# =============================================================================

# Session storage path (default: ./sessions)
WHATSAPP_SESSION_PATH=./sessions

# Headless chromium (default: true). Set to "false" only for debugging.
WHATSAPP_HEADLESS=true

# =============================================================================
# Logging
# =============================================================================

# Levels: error | warn | info | debug
LOG_LEVEL=info
