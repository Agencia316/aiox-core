# Nexus — Plataforma de Inteligência Jurídica
# Copie para .env.local e preencha. NUNCA commite .env*.

# =============================================================================
# Banco de Dados (PostgreSQL multi-tenant + RLS)
# =============================================================================
# Conexão da APLICAÇÃO — deve usar um role SEM BYPASSRLS para que as policies
# de isolamento por office_id sejam efetivas.
DATABASE_URL=postgres://nexus_app:nexus@localhost:5432/nexus

# Conexão de MIGRAÇÃO/SEED — role privilegiado (owner) usado apenas em
# migrate/seed. Nunca usado em runtime de request.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/nexus

# =============================================================================
# Auth (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET=change_me_dev_secret
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# IA — Claude (assistente "Caio")
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Modelos: claude-opus-4-5 (produção) | claude-haiku-4-5-20251001 (alto volume)
NEXUS_AI_MODEL=claude-opus-4-5

# =============================================================================
# Integrações externas (mockadas enquanto não há credenciais — ver §9)
# =============================================================================
# Liga os mocks de integração. true = não chama APIs reais.
NEXUS_USE_MOCKS=true

# Monitoramento processual — JUDIT (judit.io)
JUDIT_API_KEY=
JUDIT_TRACKING_URL=https://tracking.production.judit.io/tracking

# WhatsApp — Evolution API (self-hosted, porta 8080)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Cobrança — Asaas (sandbox)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

# Assinatura digital — ZapSign
ZAPSIGN_API_URL=https://api.zapsign.com.br/api/v1
ZAPSIGN_TOKEN=

# Peticionamento — INTIMA.AI
INTIMA_API_KEY=
